GARMIN_USERNAME=your_email@example.com
GARMIN_PASSWORD=your_password

# Optional: DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
LOG_LEVEL=INFO

# Optional: where the Garth session (auth tokens) is cached between runs.
# Defaults to ~/.garth.
GARTH_SESSION_DIR=~/.garth

# Optional: SQLite file of the body-measurement store (created on first use).
# Defaults to ~/.garmin-metrics.db.
GARMIN_METRICS_DB=~/.garmin-metrics.db
